// ===================================================================
// plakat proof corpus — SDXL tiled hi-res scripting (`plakat run`)
// ===================================================================
//   plakat run corpus/tiled_script.bund      (or: corpus/tiled_script.sh)
//
// Proves the v1.0 `plakat.tiled.*` words: enabling tiled hi-res routes the
// SD-family `plakat.generate` through the pipeline's `generate_tiled` denoise
// (the UNet only ever sees `tile_size` tiles, Hann-blended), so a script can
// render ABOVE SDXL's native 1024² without the OOM / repetition of one huge
// pass. Mirrors the CLI `--tiled`. Ungated SDXL, Metal-safe.
//
// Stack effects (see Documentation/Tutorials/SCRIPTING_TUTORIAL.md):
//   plakat.load          ( model-alias -- )
//   plakat.tiled.enable  ( -- )                ← v1.0
//   plakat.config.set    ( value key   -- )
//   plakat.generate      ( prompt       -- handle )
//   plakat.save          ( handle path  -- )

// Load SDXL (lazy — loads on first generate).
"sdxl" plakat.load

// Turn on tiled hi-res.
plakat.tiled.enable

// Render at 1280² (above SDXL's native 1024²) from 768 tiles with stride 512.
// Deliberately conservative for memory-constrained Metal: the per-tile working
// set scales with tile_size², so 768 tiles use ~56% of a 1024 tile's memory.
// On a roomy GPU you can push width/height/tile_size higher; if Metal is tight,
// shrink tile_size further or render with `--device cpu`.
"1280" "width"       plakat.config.set
"1280" "height"      plakat.config.set
"768"  "tile_size"   plakat.config.set
"512"  "tile_stride" plakat.config.set
"42"   "seed"        plakat.config.set
"30"   "steps"       plakat.config.set

// Render the prompt -> image handle.
"a sweeping alpine valley panorama at golden hour, dramatic clouds, snow peaks, a winding river, ultra-detailed, sharp focus" plakat.generate

// Save the handle. plakat.save writes relative to the run's output dir (./out),
// so this lands at ./out/tiled-valley.png; the .sh driver relocates it.
"tiled-valley.png" plakat.save
