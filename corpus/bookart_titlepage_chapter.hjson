// plakat bookart title-page — a CHAPTER page, opened by a bookart DEVICE (no full border).
// `ornament` is a procedural bookart rosette (rendered by bookart_titlepage.sh); the title-page tool
// auto-crops it to its ink and centres it as a chapter device.
//   plakat bookart title-page corpus/bookart_titlepage_chapter.hjson --out chapter.typ --verify
{
  style: "letterpress"
  page: "a5"
  lines: [
    { role: "ornament", src: "corpus/images/bookart-titlepage/device.png", size: 24 }
    { role: "part",     text: "CHAPTER I" }
    { role: "rule" }
    { role: "title",    text: "THE DEPARTURE" }
    { role: "subtitle", text: "In which our narrative begins" }
    { role: "space",    size: 1 }
    { role: "epigraph", text: "The sea, once it casts its spell, holds one in its net of wonder for ever." }
    { role: "space",    size: 0.5 }
    { role: "note",     text: "Wherein the Author sets sail from Plymouth, describes his vessel\nand crew, and encounters the first of many perils." }
  ]
}
