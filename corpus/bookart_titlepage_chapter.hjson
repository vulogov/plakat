// CHAPTER I — opened by a bookart rosette DEVICE (a seed-varied fleuron; see chapter II for a DIFFERENT
// rosette from the same fleuron at another seed). The device is auto-cropped to its ink and centred.
{
  style: "letterpress"
  page: "a5"
  lines: [
    { role: "ornament", src: "corpus/images/bookart-titlepage/rosette-1.png", size: 24 }
    { role: "part",     text: "CHAPTER I" }
    { role: "rule" }
    { role: "title",    text: "THE DEPARTURE" }
    { role: "subtitle", text: "In which our narrative begins" }
    { role: "space",    size: 1 }
    { role: "epigraph", text: "The sea, once it casts its spell, holds one in its net of wonder for ever." }
    { role: "space",    size: 0.5 }
    { role: "note",     text: "Wherein the Author sets sail from Plymouth, describes his vessel\nand crew, and encounters the first of many perils." }
  ]
}
