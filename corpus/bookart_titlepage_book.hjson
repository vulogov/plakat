// The BOOK title page, framed by the KIT's border ornament. The type box is auto-fitted to the frame's
// clear window, so the content is compact — as on a real ornamented title page.
{
  style: "letterpress"
  page: "a5"
  border: "corpus/images/bookart-titlepage/kit/00_border.png"
  lines: [
    { role: "title",    text: "VOYAGES",   size: 18 }
    { role: "title",    text: "& TRAVELS", size: 18 }
    { role: "rule" }
    { role: "note",     text: "An Account of divers Discoveries and Adventures upon the High Seas." }
    { role: "author",   text: "By Captain James Hawkins" }
    { role: "imprint",  text: "LONDON · MDCCXLI" }
  ]
}
