// plakat bookart title-page — a BOOK title page, in the old letterpress hierarchy.
// Type-only (no image assets): the typography is the whole artefact.
//   plakat bookart title-page corpus/bookart_titlepage_book.hjson --out title.typ --verify
{
  style: "letterpress"
  page: "a5"
  lines: [
    { role: "series",   text: "THE" }
    { role: "title",    text: "VOYAGES\n&\nTRAVELS" }
    { role: "subtitle", text: "OF THE CELEBRATED MARINERS" }
    { role: "rule" }
    { role: "note",     text: "Containing a full and particular Account of divers\nDiscoveries, Shipwrecks, and Adventures upon the\nHigh Seas and in Foreign Lands." }
    { role: "space",    size: 0.5 }
    { role: "author",   text: "By Captain James Hawkins" }
    { role: "imprint",  text: "LONDON\nPrinted for J. Fletcher, at the Sign of the Anchor\nMDCCXLI" }
  ]
}
