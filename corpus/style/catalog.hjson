        aggregation: top3-mean
        min_confidence: 0.22
        margin_over_runner_up: 0.02
    }

    styles:
    [
        {
            id: watercolour
            display_name: "Watercolour"
            description: ""

            exemplars:
            [
                watercolour/coast.jpeg
                watercolour/figures.jpeg
                watercolour/orchard.jpeg
                watercolour/passage.jpeg
                watercolour/quay.jpeg
                watercolour/rain-dock.jpeg
                watercolour/snow-village.jpeg
                watercolour/snow-wolves.jpeg
                watercolour/traveller.jpeg
            ]

            # Add per-base-model LoRA references + trigger phrases below.
            # Leave `models: {}` for a detection-only style (no transfer).
            models: {}
        }
    ]
}
