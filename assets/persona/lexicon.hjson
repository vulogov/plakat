{
  # PERSONA-1 lexicon — SKELETON (P0). One entry per prompt-bearing attribute; the join point between
  # the resolver, the emitters, and (later) the geometry/scorecard/calibration subsystems (RFC §7).
  #
  # Entry fields (P0 subset of §7.1):
  #   class    : structural | surface | detail       (drives salience class-weight + edit invalidation)
  #   section  : anatomical group (eyes, nose, hair, …) — used for grouping + ordering
  #   kind     : scalar | enum | color
  #   scalar   → `low` / `high` phrases (value <0.5 picks low, >0.5 picks high; ==0.5 emits nothing)
  #             the opposite pole is the negative (anti) for that attribute
  #   enum/color → `template` with `{}` replaced by the value (skip `auto` / `none`)
  #   none_negative : (enum) when the value is `none`, emit this comma list as a negative
  #   control  : default controllability grade (measured per-family later; §7.3/§13.3)
  #
  # Neutrality (§7.4): no ethnonyms, no valence. skin-tone / fitzpatrick phrasing is deliberately
  # deferred until the neutral phrasing table lands (needs the calibration pass).

  "face.shape": {
    class: surface
    section: face
    kind: enum
    template: "{}-shaped face"
    control: moderate
  }

  "face.width": {
    class: structural
    section: face
    kind: scalar
    low: "a narrow face"
    high: "a wide face"
    control: moderate
  }

  "eyes.shape": {
    class: surface
    section: eyes
    kind: enum
    template: "{} eyes"
    control: strong
  }

  "eyes.spacing": {
    class: structural
    section: eyes
    kind: scalar
    low: "close-set eyes"
    high: "wide-set eyes"
    control: strong
  }

  "eyes.color": {
    class: surface
    section: eyes
    kind: color
    template: "{} eyes"
    control: strong
  }

  "eyes.brow.thickness": {
    class: surface
    section: eyes
    kind: scalar
    low: "thin eyebrows"
    high: "thick eyebrows"
    control: moderate
  }

  "nose.profile": {
    class: surface
    section: nose
    kind: enum
    template: "a {} nose"
    control: moderate
  }

  "mouth.width": {
    class: structural
    section: mouth
    kind: scalar
    low: "a narrow mouth"
    high: "a wide mouth"
    control: moderate
  }

  "hair.color": {
    class: surface
    section: hair
    kind: color
    template: "{} hair"
    control: strong
  }

  "hair.length": {
    class: surface
    section: hair
    kind: enum
    template: "{}-length hair"
    control: strong
  }

  "hair.texture": {
    class: surface
    section: hair
    kind: enum
    template: "{} hair"
    control: strong
  }

  "facial_hair.style": {
    class: surface
    section: facial_hair
    kind: enum
    template: "a {}"
    none_negative: "beard, stubble, moustache, goatee, facial hair"
    control: moderate
  }

  "figure.build": {
    class: structural
    section: figure
    kind: enum
    template: "a {} build"
    control: weak
  }

  # --- extended coverage (P0 enrichment) ---

  "face.jaw.width": {
    class: structural
    section: face
    kind: scalar
    low: "a narrow jaw"
    high: "a wide jaw"
    control: moderate
  }

  "face.jaw.definition": {
    class: surface
    section: face
    kind: enum
    template: "a {} jawline"
    control: moderate
  }

  "face.chin.projection": {
    class: structural
    section: face
    kind: scalar
    low: "a receding chin"
    high: "a prominent chin"
    control: moderate
  }

  "face.cheekbones.prominence": {
    class: structural
    section: face
    kind: scalar
    low: "low cheekbones"
    high: "high cheekbones"
    control: moderate
  }

  "eyes.canthal_tilt": {
    class: structural
    section: eyes
    kind: scalar
    low: "downturned eyes"
    high: "upturned eyes"
    control: moderate
  }

  "eyes.brow.arch": {
    class: surface
    section: eyes
    kind: enum
    values: {
      straight: "straight eyebrows"
      soft: "softly arched eyebrows"
      rounded: "rounded eyebrows"
      angled: "angular eyebrows"
      high: "high-arched eyebrows"
    }
    control: moderate
  }

  "nose.length": {
    class: structural
    section: nose
    kind: scalar
    low: "a short nose"
    high: "a long nose"
    control: moderate
  }

  "mouth.lower_lip": {
    class: surface
    section: mouth
    kind: scalar
    low: "thin lips"
    high: "full lips"
    control: moderate
  }

  "mouth.cupids_bow": {
    class: surface
    section: mouth
    kind: enum
    values: {
      flat: ""
      soft: "a soft cupid's bow"
      defined: "a defined cupid's bow"
      pronounced: "a pronounced cupid's bow"
    }
    control: weak
  }

  # Skin tone: Fitzpatrick → neutral tone words only (§7.4 — no ethnonyms, no geographic labels).
  "skin.tone": {
    class: surface
    section: skin
    kind: enum
    values: {
      fitzpatrick-1: "very fair skin"
      fitzpatrick-2: "fair skin"
      fitzpatrick-3: "light skin"
      fitzpatrick-4: "medium skin"
      fitzpatrick-5: "tan skin"
      fitzpatrick-6: "deep skin"
    }
    control: strong
  }

  "skin.undertone": {
    class: surface
    section: skin
    kind: enum
    template: "{} undertones"
    control: moderate
  }

  "skin.texture": {
    class: surface
    section: skin
    kind: scalar
    low: "smooth skin"
    high: "textured skin"
    control: moderate
  }
}
