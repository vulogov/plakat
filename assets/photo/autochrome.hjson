# ---- the process ----
black: 0.01
white: 0.9
# ---- the carrier ----
carrier: "glass"
frame: 0.04
# ---- the age ----
age: 0.2
# ---- the neural ----
prompt: "an autochrome colour photograph from 1910, pointillist starch grain, muted warm colours, glass plate"
