{
# daguerreotype — 1839–1860: a silver-plated copper plate, iodised, exposed ten to sixty seconds behind a Petzval
# portrait lens, developed over mercury and gilded; a direct positive, laterally reversed, a mirror in the shadows,
# under glass in a brass mat. The plate sees only blue and violet: the skies white, the reds black, the freckles dark.
# ---- the camera ----
keep_subject: 1       # the studio re-lenses by the genre: the sitter keeps their size, the Petzval's draw
format: "quarter-plate"
# ---- the lens ----
aperture: 5.6         # the Petzval, opened by the director for a sitter, stopped for a view
focus: "auto"
field_curve: 0.6      # the Petzval's curved field
swirl: 0.5
vignette: 0.35
soft: 0.1
resolution: 0.4
# ---- the shutter ----
exposure_time: 15     # the cap off, the sitter braced in the head clamp
motion: 0.6
ghost: 0.2            # a street's passers-by vanish
# ---- the emulsion ----
spectral: "blue"
curve: "plate"
gamma: 1.3
toe: 0.2
latitude: 3
grain: 0.08
grain_size: 3
# ---- the process ----
tone: "silver"
tone_amount: 0.8
black: 0.01           # the mirror never goes black
white: 0.92
# ---- the carrier ----
carrier: "plate"
frame: 0.08
mirror: 1
mottle: 0.15
sheen: 0.25
# ---- the age ----
age: 0.2
silvering: 0.6
dust: 0.3
# ---- the neural ----
prompt: "a daguerreotype photograph from the 1850s on a silver plate, soft focus, mirror-like shadows, brass mat"
}
