{
# albumen — 1855–1895: the wet-collodion glass negative printed out on albumen paper — the cabinet card and the
# carte de visite; a warm purple-brown image glazed on egg white, the lights the paper's cream, mounted on card.
# ---- the camera ----
keep_subject: 1
format: "half-plate"
# ---- the lens ----
aperture: 8
focus: "auto"
field_curve: 0.3
vignette: 0.25
resolution: 0.25
# ---- the shutter ----
exposure_time: 3
motion: 0.4
ghost: 0.2
# ---- the emulsion ----
spectral: "blue"
curve: "paper"
gamma: 1.1
toe: 0.3
latitude: 4
# ---- the process ----
tone: "albumen"
black: 0.015
white: 0.9
# ---- the carrier ----
carrier: "card"
frame: 0.06
# ---- the age ----
age: 0.45
fade: 0.5
yellowing: 0.6
foxing: 0.2
# ---- the neural ----
prompt: "an 1870s albumen print cabinet card, warm sepia tones, glossy egg-white surface, mounted on card"
}
