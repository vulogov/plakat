# Generated by Cargo
# will have compiled files and executables
debug
target
/out
.claude

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by cargo mutants
# Contains mutation testing data
**/mutants.out*/

# RustRover
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
#.idea/


# Added by cargo

/target

# Downloaded model weights (often exceed GitHub's 100 MB limit)
/models/

# Tutorial-script generation outputs. The scripts under
# `examples/tutorials/*/` write PNGs into a sibling `out/`
# directory. Those are reproducible from the scripts + bundled
# inputs, so we don't track them. Same for any macOS metadata
# files the OS sprinkles around.
examples/tutorials/*/out/
**/.DS_Store

# bookart training corpus (RFC BOOKART-1). The downloaded public-domain image
# BYTES are large and fully reproducible from tools/bookart/fetch_training_corpus.py,
# so we ignore the per-artist folders but keep the script + the manifest README.
datasets/bookart_training/*/
!datasets/bookart_training/README.md

# bookart LoRA training output (host on HF, never commit)
bake/
